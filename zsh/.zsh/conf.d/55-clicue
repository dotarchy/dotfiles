#!/usr/bin/env zsh
# clicue — live contextual command guidance. Remove this file to disable.
#
# Now the Rust build (ADR-100): one binary, a daemon it auto-spawns, and a
# generated shim. Configuration lives in ~/.config/clicue/config.toml — the
# old "zstyles before source" footgun is gone. `clicue doctor` diagnoses.
#
# Loads after 50-keybindings ON PURPOSE: clicue captures whatever each key
# was bound to and delegates to it whenever the card is not engaged, so
# Down is still history-substring-search on an empty line — but only if
# clicue binds LAST. (It was 45- once; arrows never reached the card.)
#
# ── REVERT to the zsh prototype ──────────────────────────────────────────────
# Comment the eval line, uncomment the source block below. The prototype
# snapshot at ~/.local/share/clicue/prototype is frozen and self-contained;
# refresh it from the repo's prototype/ dir if ever needed.
#
#   zstyle ':clicue:*' theme aura
#   zstyle ':clicue:*' tier1-rows 10
#   zstyle ':clicue:emulates' ls lsd
#   zstyle ':clicue:keys' scroll-down '^[[1;2B' '^[[1;3B' '^[^[[B' '^[j'
#   zstyle ':clicue:keys' scroll-up   '^[[1;2A' '^[[1;3A' '^[^[[A' '^[k'
#   _clicue_src=$HOME/.local/share/clicue/prototype/clicue.zsh
#   [[ -r $_clicue_src ]] && source $_clicue_src
#   unset _clicue_src

if (( ${+commands[clicue]} )); then
  eval "$(clicue init zsh)"
fi
