# Dotfiles gitignore

# Backup directories
.dotfiles-backup/
# One-time migration backups left in place on disk, never tracked
# (`dotfiles push` stages everything, so untracked cruft must be ignored here)
zsh/.zsh/conf.d.bak-*/
zsh/.zsh/easy-zsh-config-removed-*/

# Temporary files
*.tmp
*.swp
*.swo
*~
.DS_Store

# Editor directories
.vscode/
.idea/

# Local overrides (if we add this feature later)
*.local

# Log files
*.log

# Claude Code per-project scratch (repo root only; tracked config lives in claude/)
/.claude/
# Local dev checkout of the Rust CLI source (installed as a release binary, not a submodule)
/dotfiles-tui/

# Machine-local settings that must never be committed (ADR-012): where this
# machine keeps its package lists. Sibling to .dotfiles-profile below.
.dotfiles-local.toml

# Machine-specific active profile marker (set by `dotfiles profile use`)
.dotfiles-profile
/pacrat/
